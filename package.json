{
  "name": "socialpilot-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}







