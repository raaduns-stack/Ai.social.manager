# RaaSocial Backend Environment Variables

# --- App General Configuration ---
# Current Node execution context (e.g. development, production)
NODE_ENV=development
# Port number NestJS server listens on (Defaults to 4000)
PORT=4000
# Routing prefix for all API endpoints (Defaults to 'api')
API_PREFIX=api
# Allowed origins for CORS requests
CORS_ORIGIN=http://localhost:5173
# Frontend callback base URL used for redirect callbacks (Defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173
# Token check used by local microservices validation (e.g. system status checkers)
NESTJS_SERVICE_TOKEN=your_nestjs_service_token_placeholder

# --- Database & Security Configuration ---
# Neon Serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/socialpilot_ai
# Symmetric 256-bit AES encryption key used to encrypt secrets in the database. MUST be exactly 32 characters.
SETTINGS_ENCRYPTION_KEY=12345678901234567890123456789012

# --- JWT Authentication Secrets ---
# Secret key used to sign access JWTs
JWT_ACCESS_SECRET=your_jwt_access_secret_placeholder
# Expiration timing window for access JWTs (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Secret key used to sign refresh session JWTs
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder
# Expiration timing window for refresh JWTs (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# --- Payment Gateway (Flutterwave) ---
# Secret API key provided by Flutterwave (e.g. FLWSECK_TEST-...)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key_placeholder
# Custom verif-hash matched against incoming Flutterwave webhook payloads
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_webhook_secret_hash_placeholder

# --- AI Providers & Direct Integrations ---
# API key for direct Gemini model queries
GEMINI_API_KEY=your_gemini_api_key_placeholder
# API key for direct OpenClaw automated browser interface (Planned / Stubbed)
OPENCLAW_API_KEY=your_openclaw_api_key_placeholder
# Gateway URL pointing to the OpenClaw execution endpoint (Planned / Stubbed)
OPENCLAW_GATEWAY_URL=https://gateway.openclaw.io/v1

# --- Redis Task Queues ---
# Redis server connection URL (Planned / Stubbed)
REDIS_URL=redis://localhost:6379

# --- Support ---
# WhatsApp support hotline number (Format: digits only, e.g. 2348000000000)
SUPPORT_WHATSAPP_NUMBER=2348000000000

# --- SMTP / Resend Email fallbacks ---
# SMTP hostname server (e.g. mail.raasocial.io)
SMTP_HOST=mail.raasocial.io
# SMTP listening port (e.g. 465, 587)
SMTP_PORT=465
# Require SSL/TLS connection protocol (true / false)
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME="SocialPilot AI"
SMTP_SENDER_EMAIL=

# n8n Integration
N8N_CALENDAR_GENERATION_WEBHOOK_URL=
N8N_INTERNAL_API_KEY=
N8N_PUBLISHING_WEBHOOK_URL=

# TikTok Integration (Login Kit + Content Posting API + Webhooks)
# Client Key is the "App ID" shown in the TikTok Developer Portal.
TIKTOK_CLIENT_KEY=your_tiktok_client_key
# Client Secret — NEVER expose this to the frontend or commit to version control.
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# Must exactly match the Redirect URI registered in TikTok Developer Portal:
TIKTOK_REDIRECT_URI=https://raasocial.io/api/channels/tiktok/callback
# Optional shared token for additional webhook identity verification.
TIKTOK_WEBHOOK_VERIFY_TOKEN=your_tiktok_webhook_verify_token

# Discord Integration (OAuth2 + Bot Integration)
# Client ID from Discord Developer Portal -> RaaSocial -> General Information
DISCORD_CLIENT_ID=your_discord_client_id
# Client Secret — NEVER expose this to the frontend or commit to version control.
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Must exactly match the Redirect URI registered in Discord Developer Portal -> OAuth2 -> Redirects:
DISCORD_REDIRECT_URI=https://raasocial.io/api/channels/discord/callback
# Optional Bot Token for server/channel messaging actions
DISCORD_BOT_TOKEN=your_discord_bot_token

# Username to authenticate against the SMTP server
SMTP_USERNAME=smtp_username_placeholder
# Password to authenticate against the SMTP server
SMTP_PASSWORD=smtp_password_placeholder
# Sender display label signature (Defaults to 'RaaSocial')
SMTP_SENDER_NAME="RaaSocial"
# Sender email address signature
SMTP_SENDER_EMAIL=noreply@raasocial.io
# Fallback email sender address if SMTP sender email is omitted
MAIL_FROM=noreply@raasocial.io
# API access key for Resend email API integration (Alternative fallback)
RESEND_API_KEY=re_your_resend_api_key_placeholder

# --- n8n Workflow Automations ---
# n8n webhook triggered when generating bulk calendar schedules
N8N_CALENDAR_GENERATION_WEBHOOK_URL=https://n8n.raasocial.io/webhook/calendar/generate
# n8n webhook triggered when generating specific caption suggestions
N8N_CONTENT_SUGGESTIONS_WEBHOOK_URL=https://n8n.raasocial.io/webhook/content-suggestions/generate
# Shared key used to validate incoming n8n webhook callback requests
N8N_INTERNAL_API_KEY=your_n8n_internal_api_key_placeholder
# n8n webhook triggered to dispatch publication requests
N8N_PUBLISHING_WEBHOOK_URL=https://n8n.raasocial.io/webhook/posts/publish
# n8n webhook used to generate caption suggestions (legacy config mapping)
AI_SUGGESTIONS_N8N_GENERATION_WEBHOOK_URL=https://n8n.raasocial.io/webhook/ai-suggestions/generate
# n8n webhook used to revise caption suggestions
AI_SUGGESTIONS_N8N_REVISION_WEBHOOK_URL=https://n8n.raasocial.io/webhook/ai-suggestions/revise
