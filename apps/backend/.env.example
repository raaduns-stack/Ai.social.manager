# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (matches the socialpilot_ai Postgres instance from the dev server doc)
DATABASE_URL=postgresql://socialpilot_user:CHANGE_ME@localhost:5432/socialpilot_ai

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# AI providers (fill in when integrating)
GEMINI_API_KEY=
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_URL=

# Redis / Queues
REDIS_URL=redis://localhost:6379
